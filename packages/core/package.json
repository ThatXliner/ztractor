{
    "name": "ztractor",
    "description": "Extract metadata from websites using Zotero's 600+ translators",
    "version": "1.0.0",
    "type": "module",
    "author": "Bryan Hu",
    "license": "AGPL-3.0-or-later",
    "keywords": [
        "zotero",
        "metadata",
        "scraping",
        "translator",
        "citation",
        "bibliographic",
        "web-scraping",
        "extraction",
        "academic",
        "research"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ThatXliner/ztractor.git",
        "directory": "packages/core"
    },
    "bugs": {
        "url": "https://github.com/ThatXliner/ztractor/issues"
    },
    "homepage": "https://github.com/ThatXliner/ztractor#readme",
    "files": [
        "dist"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "bun run build:zotero-runtime && bun bundle-translators.ts && bunx bunup --exports -t browser",
        "build:zotero-runtime": "bun scripts/build-zotero-runtime.ts",
        "codemods:check": "bun codemods/run-codemods.ts --check",
        "codemods:write": "bun codemods/run-codemods.ts --write",
        "upgrade:zotero": "bun scripts/upgrade-zotero.ts",
        "test": "bun test"
    },
    "devDependencies": {
        "@types/bun": "^1.3.2",
        "bunup": "^0.15.14",
        "typescript": "^5"
    }
}
