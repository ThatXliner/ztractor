{
	"name": "ztractor",
	"description": "Extract metadata from websites using Zotero's 600+ translators",
	"version": "1.0.0",
	"type": "module",
	"author": "Bryan Hu",
	"license": "AGPL-3.0-or-later",
	"keywords": [
		"zotero",
		"metadata",
		"scraping",
		"translator",
		"citation",
		"bibliographic",
		"web-scraping",
		"extraction",
		"academic",
		"research"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ThatXliner/ztractor.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/ThatXliner/ztractor/issues"
	},
	"homepage": "https://github.com/ThatXliner/ztractor#readme",
	"files": [
		"dist"
	],
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun bundle-utilities.ts && bun bundle-translate.ts && bun bundle-translators.ts && bunx bunup --exports -t browser",
		"build:utilities": "bun bundle-utilities.ts",
		"build:translate": "bun bundle-translate.ts",
		"build:translators": "bun bundle-translators.ts",
		"test": "bun test"
	},
	"devDependencies": {
		"@babel/parser": "^7.28.5",
		"@biomejs/biome": "2.3.10",
		"@types/bun": "^1.3.2",
		"bunup": "^0.15.14",
		"recast": "^0.23.11",
		"typescript": "^5"
	}
}
